{
  "name": "book-printing-platform-api",
  "version": "1.0.0",
  "description": "Secure book printing management API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "migrate": "knex migrate:latest --knexfile src/config/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/config/knexfile.ts",
    "seed": "knex seed:run --knexfile src/config/knexfile.ts",
    "seed:legacy": "tsx src/database/seeds/index.ts",
    "test": "jest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "bcryptjs": "^2.4.0",
    "canvas": "^3.2.3",
    "cors": "^2.8.0",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.3.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.0",
    "pdfjs-dist": "^4.0.379",
    "pg": "^8.0.0",
    "puppeteer": "^22.0.0",
    "typescript": "^5.0.0",
    "winston": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/puppeteer": "^7.0.4",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  }
}
